# One nginx config for everything on this Lightsail server.
#
#   renoble.agency, www.renoble.agency  -> /var/www/renoble/public        (marketing website)
#   studio.renoble.agency               -> /var/www/renoble/admin/dist    (admin panel)
#   studio.renoble.agency/api/*         -> Node API on 127.0.0.1:4000
#
# Install:
#   sudo cp /var/www/renoble/backend/deploy/renoble /etc/nginx/sites-available/renoble
#   sudo ln -sf /etc/nginx/sites-available/renoble /etc/nginx/sites-enabled/renoble
#   sudo rm -f /etc/nginx/sites-enabled/default
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d renoble.agency -d www.renoble.agency -d studio.renoble.agency

# ---------- marketing website ----------
server {
    listen 80;
    listen [::]:80;
    server_name renoble.agency www.renoble.agency;

    root /var/www/renoble/public;
    index index.html;
    server_tokens off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # clean URLs: /terms -> terms.html
    location / {
        try_files $uri $uri.html $uri/ =404;
    }

    location /assets/ {
        expires 30d;
        add_header Cache-Control "public";
    }

    error_page 404 /404.html;
}

# ---------- admin panel + API ----------
server {
    listen 80;
    listen [::]:80;
    server_name studio.renoble.agency;

    root /var/www/renoble/admin/dist;
    index index.html;
    server_tokens off;
    client_max_body_size 10m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # API -> Node
    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_connect_timeout 10s;
    }

    # hashed build files can be cached for a long time
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # React single-page app: any other path serves index.html
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
