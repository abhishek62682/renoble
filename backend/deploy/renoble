# /etc/nginx/sites-available/renoble  (then symlink into sites-enabled)
#
#   sudo cp deploy/renoble /etc/nginx/sites-available/renoble
#   sudo ln -s /etc/nginx/sites-available/renoble /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d api.renoble.agency     # adds the HTTPS block + redirect

server {
    listen 80;
    listen [::]:80;
    server_name api.renoble.agency;

    # uploads / large JSON bodies
    client_max_body_size 10m;

    # basic hardening
    server_tokens off;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    gzip on;
    gzip_types application/json text/plain text/css application/javascript;

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 60s;
        proxy_connect_timeout 10s;
    }
}
